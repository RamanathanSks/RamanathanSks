rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only portfolio collections; writes only via Admin SDK / Firebase Console
    match /gallery/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /cards/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /home/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /image/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /tiles/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other collections and writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
